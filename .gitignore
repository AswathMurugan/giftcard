# Per-session workspaces (created by scripts/new-session.sh)
tmp/

# Chat journals (pi session transcripts). In cloud these are written INSIDE
# the workspace (SESSION_ROOT=/workspace/.sessions), and the per-turn save
# stages with `git add -A` — without this rule the full conversation
# transcript gets committed into the app repo. Must stay in sync with
# GITIGNORE_CONTENT in backend-node/src/bootstrap/repo.ts.
.sessions/

