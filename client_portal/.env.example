# Phoenix platform API base URL (no trailing slash).
# Used by scripts/fetch-entities.ts to pull entity definitions for a tenant.
PHOENIX_API_URL=https://jiffy.us.sandbox.phoenix.jiffy.ai

# Tenant slug sent as the `X-Jiffy-Tenant` header when calling the API.
TENANT_ID=aiwithdata

# OPTIONAL — local dev only. Cognito access token for fetching from a PUBLIC
# Phoenix host (e.g. prod), where CloudFront blocks the `/api/internal/*` paths
# the fetch scripts normally use. When set, the fetch scripts drop the
# `/internal` path segment and send `Authorization: Bearer <token>` so the data
# is served through the authenticated gateway instead. Leave UNSET for sandbox
# or the in-VPC cloud bootstrap (then internal paths + header-only auth are used).
# The token is short-lived (~1h); obtain one per tenant and never commit it.
# PHOENIX_AUTH_TOKEN=

# Origin of the parent window that hosts this app in an iframe (e.g. the
# Jiffy preview shell). When set AND the app is running in dev mode,
# `src/shared/utils/logger.ts` mirrors every logged event to
# `window.parent.postMessage(...)` with this value as `targetOrigin`.
# Leave empty to disable the iframe bridge.
VITE_PARENT_ORIGIN=http://localhost:5173

# LOCAL DEV ONLY — required for the agent chat's AppSync Events WebSocket.
# The endpoint itself is never an env var: it arrives on the tenant auth
# config response (`websocket_url`), per-tenant and per-environment, so
# sandbox/prod need NO AppSync configuration at all. Only the CREDENTIAL
# differs by host — a deployed app authenticates with the signed-in user's
# Cognito token; localhost has no such session, so it falls back to this
# API key instead. Without it, the chat reports it can't connect (by design)
# — see src/queries/AGENT-CHAT.md §9.
VITE_APPSYNC_API_KEY=your-appsync-api-key-here
# Mapbox public token for address autofill. Leave blank to disable autofill.
VITE_MAPBOX_TOKEN=
